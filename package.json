{
  "name": "ects-career-portfolio",
  "version": "1.0.0",
  "description": "Standalone desktop career portfolio creator.",
  "author": "ECTS",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable",
    "build:msi": "electron-builder --win msi",
    "package": "npm run build"
  },
  "devDependencies": {
    "electron-builder": "^26.0.12",
    "electron": "^44.5.1"
  },
  "build": {
    "appId": "org.ects.careerportfolio",
    "productName": "ECTS Career Portfolio",
    "artifactName": "ECTS-Career-Portfolio-${version}-portable.${ext}",
    "win": {
      "signExecutable": false
    },
    "msi": {
      "artifactName": "ECTS-Career-Portfolio-${version}-setup.${ext}"
    },
    "files": [
      "index 1.html",
      "style.css",
      "required-fields.css",
      "script.js",
      "portfolio-quality.js",
      "export.html",
      "preview.html",
      "preview.css",
      "preview.js",
      "document-preview.js",
      "export-final.js",
      "main.cjs",
      "preload.cjs",
        "examples/showcase.ects-portfolio",
      "package.json"
    ]
  },
  "dependencies": {
    "pdfjs-dist": "^6.4.299",
    "docx-preview": "^0.4.1"
  }
}
